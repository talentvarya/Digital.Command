# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key -- server-side only, NEVER expose to the browser.
# Not required for Phase 1's own mutations (those run under RLS with the
# caller's own session), but reserved for future admin/backfill tooling.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Base URL of this deployment, used to build Supabase Auth redirect links
# (email confirmation, password reset). Use http://localhost:3000 for local dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Anthropic API key — server-side only. Powers AI caption generation in the
# 7-Day Planner (Autopilot / Approval Required). Get one at console.anthropic.com.
ANTHROPIC_API_KEY=sk-ant-...

# Google OAuth client — server-side only. Powers the SEO page's Search Console
# / Analytics connections. Create at console.cloud.google.com:
#   1. New project -> APIs & Services -> enable "Google Search Console API"
#      and "Google Analytics Data API" (+ "Google Analytics Admin API").
#   2. OAuth consent screen -> add scopes webmasters.readonly + analytics.readonly.
#      Until this app is verified by Google, only accounts you add as Test
#      Users can connect (spec open item §37.13) — can take days/weeks to
#      verify for production use with sensitive scopes.
#   3. Credentials -> Create OAuth client ID (Web application) -> add
#      redirect URI: {NEXT_PUBLIC_SITE_URL}/api/google/oauth/callback
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
