# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key -- server-side only, NEVER expose to the browser.
# Not required for Phase 1's own mutations (those run under RLS with the
# caller's own session), but reserved for future admin/backfill tooling.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Base URL of this deployment, used to build Supabase Auth redirect links
# (email confirmation, password reset). Use http://localhost:3000 for local dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Anthropic API key — server-side only. Powers AI caption generation in the
# 7-Day Planner (Autopilot / Approval Required). Get one at console.anthropic.com.
ANTHROPIC_API_KEY=sk-ant-...

# Google OAuth client — server-side only. Powers the SEO page's Search Console
# / Analytics / YouTube connections. Create at console.cloud.google.com:
#   1. New project -> APIs & Services -> enable "Google Search Console API",
#      "Google Analytics Data API" (+ "Google Analytics Admin API"), and
#      "YouTube Data API v3".
#   2. OAuth consent screen -> add scopes webmasters.readonly, analytics.readonly,
#      youtube.upload, youtube.readonly. Until this app is verified by Google,
#      only accounts you add as Test Users can connect (spec open item §37.13)
#      — can take days/weeks to verify for production use with sensitive scopes.
#   3. Credentials -> Create OAuth client ID (Web application) -> add
#      redirect URI: {NEXT_PUBLIC_SITE_URL}/api/google/oauth/callback
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Buffer personal API key — server-side only. NOT per-client: Buffer's current
# API (2026) only supports a personal key tied to ONE Buffer login, not
# third-party OAuth for onboarding many separate client accounts (their old
# OAuth-based API is closed to new developer registrations). So this is VMG's
# own Buffer account; each client's Facebook Page/Instagram account gets added
# as a "channel" to that one account via Buffer's own site (buffer.com —
# Settings -> API -> create a personal API key), then linked to the right
# client from Digital Command's admin panel (Client detail -> Publishing
# Channels). See ARCHITECTURE.md for the full reasoning.
BUFFER_ACCESS_TOKEN=your-buffer-personal-api-key
