# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key -- server-side only, NEVER expose to the browser.
# Not required for Phase 1's own mutations (those run under RLS with the
# caller's own session), but reserved for future admin/backfill tooling.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Base URL of this deployment, used to build Supabase Auth redirect links
# (email confirmation, password reset). Use http://localhost:3000 for local dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Anthropic API key — server-side only. Powers AI caption generation in the
# 7-Day Planner (Autopilot / Approval Required). Get one at console.anthropic.com.
ANTHROPIC_API_KEY=sk-ant-...

# Which AI provider generation calls use — optional, defaults to "anthropic"
# when unset. "gemini"/"openai" switch every generation call EXCEPT the
# AI Assistant (which is always Claude — see lib/ai/provider.ts) to that provider.
# AI_PROVIDER=anthropic

# Google Gemini API key — server-side only, only needed when AI_PROVIDER=gemini.
# Get one at aistudio.google.com/apikey (a different credential from the
# GOOGLE_CLIENT_ID/GOOGLE_CUSTOM_SEARCH_API_KEY below — this is the Generative
# Language API, not OAuth or Custom Search).
GEMINI_API_KEY=...

# OpenAI API key — server-side only, only needed when AI_PROVIDER=openai.
# Get one at platform.openai.com/api-keys.
OPENAI_API_KEY=sk-...

# Google OAuth client — server-side only. Powers the SEO page's Search Console
# / Analytics / YouTube connections. Create at console.cloud.google.com:
#   1. New project -> APIs & Services -> enable "Google Search Console API",
#      "Google Analytics Data API" (+ "Google Analytics Admin API"), and
#      "YouTube Data API v3".
#   2. OAuth consent screen -> add scopes webmasters.readonly, analytics.readonly,
#      youtube.upload, youtube.readonly. Until this app is verified by Google,
#      only accounts you add as Test Users can connect (spec open item §37.13)
#      — can take days/weeks to verify for production use with sensitive scopes.
#   3. Credentials -> Create OAuth client ID (Web application) -> add
#      redirect URI: {NEXT_PUBLIC_SITE_URL}/api/google/oauth/callback
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Buffer personal API key — server-side only. NOT per-client: Buffer's current
# API (2026) only supports a personal key tied to ONE Buffer login, not
# third-party OAuth for onboarding many separate client accounts (their old
# OAuth-based API is closed to new developer registrations). So this is VMG's
# own Buffer account; each client's Facebook Page/Instagram account gets added
# as a "channel" to that one account via Buffer's own site (buffer.com —
# Settings -> API -> create a personal API key), then linked to the right
# client from Digital Command's admin panel (Client detail -> Publishing
# Channels). See ARCHITECTURE.md for the full reasoning.
BUFFER_ACCESS_TOKEN=your-buffer-personal-api-key

# Google Custom Search JSON API — server-side only, app-wide (not per-org, no
# OAuth). Powers the Off-Page & Outreach page's "unlinked brand mentions"
# search (spec §9.2). Free tier: 100 queries/day, then paid. Create at
# programmablesearchengine.google.com:
#   1. Create a search engine -> set it to search the entire web.
#   2. Copy its Search engine ID -> GOOGLE_CUSTOM_SEARCH_ENGINE_ID.
#   3. console.cloud.google.com -> enable "Custom Search API" -> Credentials
#      -> Create API key -> GOOGLE_CUSTOM_SEARCH_API_KEY.
GOOGLE_CUSTOM_SEARCH_API_KEY=your-custom-search-api-key
GOOGLE_CUSTOM_SEARCH_ENGINE_ID=your-search-engine-id

# Unsplash — server-side only, app-wide, free (no billing). Auto-attaches a
# stock photo matching each AI-generated caption in the 7-Day Planner. Create
# at unsplash.com/oauth/applications -> New Application -> copy its Access Key.
UNSPLASH_ACCESS_KEY=your-unsplash-access-key

# VMG's own WhatsApp/phone number — public (NEXT_PUBLIC_), shown as the
# "Chat on WhatsApp" / "Call now" buttons on the free public roadmap tool
# (/roadmap) once a lead's roadmap is generated. Digits only, with country
# code, no + or spaces (e.g. 919876543210) for the wa.me link format.
NEXT_PUBLIC_VMG_WHATSAPP_NUMBER=91XXXXXXXXXX
NEXT_PUBLIC_VMG_PHONE=+91XXXXXXXXXX

# Token encryption key — server-side only, OPTIONAL but recommended. When set,
# third-party tokens saved from then on (a client's Google connections and Apify
# API token) are stored AES-256-GCM encrypted instead of as readable text in the
# database (see lib/security/secret-box.ts). Tokens saved BEFORE it was set stay
# readable and keep working; reconnecting re-saves them encrypted. Generate a
# long random string once (e.g. `openssl rand -base64 32`) and NEVER change or
# lose it afterwards — tokens encrypted with it can't be read with a different
# key, and every affected client would have to reconnect.
# TOKEN_ENCRYPTION_KEY=your-long-random-string

# Cron auth secret — server-side only. Authenticates Vercel Cron's daily call
# to /api/cron/planner-fill (see vercel.json), which keeps every Autopilot
# org's Content Planner filled ~2 days ahead instead of generating a whole
# window at once (spreads Unsplash/AI usage evenly, avoids the 50 req/hour
# Unsplash rate limit). Generate any random string, e.g. `openssl rand -hex
# 32`, and set the SAME value here and in Vercel's Environment Variables.
CRON_SECRET=your-random-secret
